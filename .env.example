# Mapbox 公开 token（pk. 开头）。驾车/步行/骑行等时圈与底图都靠它。
# 前端可见，应在 Mapbox 控制台配置 URL restriction。
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# 高德 JS API Key（Web端）。地名搜索 + 公交/地铁等时圈（ArrivalRange）用。
# 前端可见，靠控制台的域名白名单约束。
VITE_AMAP_KEY=your_amap_js_api_key_here

# —— 安全密钥，二选一 ——

# 明文模式：仅限本地开发。这个值会被打进 bundle，公开部署等于公开密钥。
VITE_AMAP_SECURITY_CODE=your_security_code_here

# 代理模式：生产环境用这个。安全密钥存在代理服务器上，不进前端。
# VITE_AMAP_SERVICE_HOST=https://your-proxy.workers.dev/_AMapService
